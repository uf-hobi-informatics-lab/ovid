# Ignore Hidden MacOS System Files
.DS_Store

# Ignore Sensitive Files with Keys, Passwords etc.
partners/
common/ovid_secrets.py
ovid_setup/install_settings.py
common/cdm/omop_5_3/*.csv

# Large reference data that ships separately (too big for git)
common/lists/FULL_GEOCODING_*.csv
common/omop_cdm/*.csv

# Runtime instance-scoped bundles (may contain ovid_secrets.py)
common-*.zip

# Safety net for credential, key, and environment files
*.p8
*.pem
*.key
*.pfx
*.env
.env.*

# Ignore the installation of Python
Python-3.10.5

# Ignore log files created as part of the process.
*.log

# Ignore folder created when code is executed
__pycache__/
*.pyc

# Ignore editor/IDE temp and config files
*.py.un~
*.swp
*.swo
*~
.vscode/
.idea/

# Ignore runtime and generated files
work_directory/
docker_data/
tmp/
to_datavant_inbox/
work_directory/docker_data/spark_tmp/
docker-compose.yml

# Internal tooling / AI agent workspaces (not for public repo)
.opencode/
.omo/
.ovid_sync/
.ruff_cache/
